# Referência: cadastre estas variáveis PRIVADAS nas configurações Vercel.
# O arquivo .env não é carregado automaticamente.
PORT=80
PORTAL_ENV=production
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# Gere um segredo aleatório; não há valor padrão.
STREAMLIT_SERVER_COOKIE_SECRET=
# Bootstrap executado somente enquanto o banco ainda não possui contas.
PORTAL_ADMIN_EMAIL=professor@example.edu
PORTAL_ADMIN_NAME=Professor
# Preencha com uma senha exclusiva de pelo menos 12 caracteres.
PORTAL_ADMIN_PASSWORD=
