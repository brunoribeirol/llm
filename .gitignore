# agent-workspace:v8:start
# Python bytecode cache (any directory, not just the hook runtime -- this
# framework's own repo ships real Python source under lib/, and running any
# python3 command against it generates __pycache__/*.pyc that must never be
# committed).
__pycache__/
*.pyc

# Agent workspace local state
.agents/state/
CLAUDE.local.md

# Optional generated indexes
graphify-out/cache/
# agent-workspace:v8:end

# Teacher-only files from the professor's portal (lab solutions, exam answer key).
# Kept on this machine for after-the-fact checking; never pushed.
reference/teacher-only/
